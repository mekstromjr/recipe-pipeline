# Secrets
.env

# Python
__pycache__/
.venv/
*.egg-info/
.pytest_cache/

# Pipeline data — scans, rendered pages, and outputs are local only (not versioned).
# Keep the root directories (via .gitkeep) but ignore their contents, and ignore these
# data/log dirs wherever they appear (e.g. worker/output/ when the worker runs from worker/).
inbox/*
!inbox/.gitkeep
output/*
!output/.gitkeep
samples/*
!samples/.gitkeep
**/output/
**/inbox/
*.log

# Model / HF caches that may land in-tree
.cache/
*.safetensors
*.mlmodel
