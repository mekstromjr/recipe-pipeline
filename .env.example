# Recipe Pipeline configuration. Copy to `.env` and adjust.
# All vars are prefixed RECIPE_ (pydantic-settings env_prefix).

# --- Models: CPU Ollama in <ct> (`ollama.meklab.net`) — NOT this Mac ---
# <ct> has moved PVE hosts twice (<pve-host> -> <pve-host> -> <pve-host>), keeping .42 and the DNS name.
# Prefer the NAME, and re-check cores/memory after a move rather than assuming they carried.
# The worker runs in-cluster and reaches it over the LAN, same as scribe. Ollama ships no
# authentication, so 11434 is restricted to the k3s NODES by iptables INPUT rules inside the
# CT. A laptop cannot reach it, and neither can the PVE host it runs on — tunnel through a
# k3s node:
#   ssh -N -L 11500:<lan-ip>:11434 mekadmin@<lan-ip>
#   RECIPE_OLLAMA_HOST=http://127.0.0.1:11500
# Do NOT use local port 11434: a native ollama on the Mac binds IPv4 127.0.0.1 while the
# forward binds IPv6 [::1], so "localhost:11434" silently resolves to the wrong server.
RECIPE_OLLAMA_HOST=http://ollama.meklab.net:11434

# OCR. glm-ocr is NOT a chat model (its template is a bare `{{ .Prompt }}`) — it is driven via
# /api/generate and requires a non-empty prompt.
RECIPE_OCR_MODEL=glm-ocr:latest
# Text stages. Honors JSON-schema structured output; a thinking model, so think=False.
RECIPE_TEXT_MODEL=qwen3.5:4b

# Per-request thread pool. Must equal <ct>'s `cores` (3). llama.cpp sizes its pool from HOST
# cores and ignores the cgroup, so leaving it unset oversubscribes. No server-side setting.
RECIPE_NUM_THREAD=3

# Longest edge for images sent to the vision model; full-res buys no accuracy at this size.
RECIPE_OCR_MAX_EDGE=1500
# Token ceiling for OCR. glm-ocr RUNS AWAY on faint input — uncapped, a faint test page never
# returned; capped, it terminates in ~185s. Do not remove.
RECIPE_OCR_NUM_PREDICT=2048
RECIPE_OLLAMA_TIMEOUT_SECONDS=900
# Must match OLLAMA_CONTEXT_LENGTH on the server. Over-length input is truncated SILENTLY.
# DO NOT RAISE ALONE: a near-full 32k window OOM-killed the server inside <ct>'s then-6G cap.
# The window, the CT memory cap, and LLAMA_ARG_CACHE_RAM are sized TOGETHER.
RECIPE_OLLAMA_NUM_CTX=16384

# --- Metadata enrichment (local model + your SearXNG) ---
# SearXNG's public ingress sits behind Authentik; for programmatic JSON access run
#   kubectl -n prod port-forward svc/searxng 8888:8080
# and point this at the forward. (Same pattern as Mealie below.)
RECIPE_SEARXNG_URL=http://localhost:8888

# --- Mealie upload target ---
# The mealie Service is plain ClusterIP:9000 with NO Authentik (that's only at the ingress).
# Run:  kubectl -n prod port-forward svc/mealie 9000:9000
RECIPE_MEALIE_URL=http://localhost:9000
# Long-lived API token — mint in the Mealie UI (user menu -> Manage Your API Tokens).
RECIPE_MEALIE_API_TOKEN=
# Fixed tags added to every uploaded recipe (filter this batch in Mealie). Comma-separated.
RECIPE_GROUP_TAGS=a family member,Scan,recipe-pipeline-v1

# --- OCR backend (single engine: glm-ocr in <ct>) ---
RECIPE_OCR_BACKEND=glmocr

# --- Cloud escalation (`recipe-pipeline escalate`): re-OCR FAILED cards with a strong cloud
# vision model that reads hard cursive far better. Only the failed tail leaves the machine.
# Copy the value from .env's OPEN_ROUTER_KEY.
RECIPE_OPENROUTER_API_KEY=
RECIPE_OPENROUTER_OCR_MODEL=google/gemini-2.5-flash

# --- Directories (relative to the project root, or an absolute path) ---
# Point this at your scans folder to batch-process them in place (no copying), e.g.:
#   RECIPE_INPUT_DIR=/path/to/scansDocuments
RECIPE_INPUT_DIR=inbox
RECIPE_OUTPUT_DIR=output
RECIPE_SAMPLES_DIR=samples
