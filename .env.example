# Recipe Pipeline configuration. Copy to `.env` and adjust.
# All vars are prefixed RECIPE_ (pydantic-settings env_prefix).

# --- Local reconcile model (Ollama on this Mac) ---
RECIPE_OLLAMA_HOST=http://localhost:11434
# Vision-capable local model used to reconcile the two OCR transcripts against the page image.
# `-32k` long-context variant fits two transcripts + image + instructions comfortably.
# NOTE: verify this tag actually accepts image input via Ollama; fallback: a Qwen2.5-VL tag.
RECIPE_RECONCILE_MODEL=gemma4:26b-mlx-32k

# --- Metadata enrichment (local model + your SearXNG) ---
# SearXNG's public ingress sits behind Authentik; for programmatic JSON access run
#   kubectl -n prod port-forward svc/searxng 8888:8080
# and point this at the forward. (Same pattern as Mealie below.)
RECIPE_SEARXNG_URL=http://localhost:8888

# --- Mealie upload target ---
# The mealie Service is plain ClusterIP:9000 with NO Authentik (that's only at the ingress).
# Run:  kubectl -n prod port-forward svc/mealie 9000:9000
RECIPE_MEALIE_URL=http://localhost:9000
# Long-lived API token — mint in the Mealie UI (user menu -> Manage Your API Tokens).
RECIPE_MEALIE_API_TOKEN=

# --- OCR backends (two DIFFERENT architectures for the consensus step) ---
# Options: trocr | kraken | applevision  (final pair chosen via the bake-off)
RECIPE_OCR_A=trocr
RECIPE_OCR_B=kraken

# --- Directories (relative to the project root) ---
RECIPE_INPUT_DIR=inbox
RECIPE_OUTPUT_DIR=output
RECIPE_SAMPLES_DIR=samples
