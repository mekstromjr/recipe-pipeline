# Recipe Pipeline configuration. Copy to `.env` and adjust.
# All vars are prefixed RECIPE_ (pydantic-settings env_prefix).

# --- Local models (Ollama on this Mac) ---
RECIPE_OLLAMA_HOST=http://localhost:11434
# VISION model (the review pass sees the page image). gemma4:e4b has the `vision` capability;
# the gemma4 MLX tags are TEXT-ONLY (verify any tag with `ollama show <tag>`).
RECIPE_VISION_MODEL=gemma4:e4b
# Text-LLM stages (structure, enrich, orientation A/B). e4b honors JSON-schema output and is
# fast; the gemma4 MLX tags are slow and ignore structured-output format.
RECIPE_ENRICH_MODEL=gemma4:e4b
# Context window per request. Ollama's default (~4096) SILENTLY TRUNCATES longer prompts (can
# drop the system rules / start of transcripts). Vision requests also spend tokens on the image.
RECIPE_OLLAMA_NUM_CTX=16384

# --- Metadata enrichment (local model + your SearXNG) ---
# SearXNG's public ingress sits behind Authentik; for programmatic JSON access run
#   kubectl -n prod port-forward svc/searxng 8888:8080
# and point this at the forward. (Same pattern as Mealie below.)
RECIPE_SEARXNG_URL=http://localhost:8888

# --- Mealie upload target ---
# The mealie Service is plain ClusterIP:9000 with NO Authentik (that's only at the ingress).
# Run:  kubectl -n prod port-forward svc/mealie 9000:9000
RECIPE_MEALIE_URL=http://localhost:9000
# Long-lived API token — mint in the Mealie UI (user menu -> Manage Your API Tokens).
RECIPE_MEALIE_API_TOKEN=
# Fixed tags added to every uploaded recipe (filter this batch in Mealie). Comma-separated.
RECIPE_GROUP_TAGS=a family member,Scan,recipe-pipeline-v1

# --- OCR backend (single engine: Apple Vision, on-device) ---
RECIPE_OCR_A=applevision

# --- Cloud escalation (`recipe-pipeline escalate`): re-OCR FAILED cards with a strong cloud
# vision model that reads hard cursive far better. Only the failed tail leaves the machine.
# Copy the value from .env's OPEN_ROUTER_KEY.
RECIPE_OPENROUTER_API_KEY=
RECIPE_OPENROUTER_OCR_MODEL=google/gemini-2.5-flash

# --- Directories (relative to the project root, or an absolute path) ---
# Point this at your scans folder to batch-process them in place (no copying), e.g.:
#   RECIPE_INPUT_DIR=/path/to/scansDocuments
RECIPE_INPUT_DIR=inbox
RECIPE_OUTPUT_DIR=output
RECIPE_SAMPLES_DIR=samples
